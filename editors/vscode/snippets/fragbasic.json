{
  "If / Then": {
    "prefix": "if",
    "body": ["IF ${1:condition} THEN", "    ${0}", "END IF"],
    "description": "A multi-line IF block"
  },
  "If / Else": {
    "prefix": "ifelse",
    "body": ["IF ${1:condition} THEN", "    ${2}", "ELSE", "    ${0}", "END IF"],
    "description": "An IF / ELSE block"
  },
  "If / ElseIf / Else": {
    "prefix": "ifelseif",
    "body": [
      "IF ${1:condition} THEN",
      "    ${2}",
      "ELSEIF ${3:condition} THEN",
      "    ${4}",
      "ELSE",
      "    ${0}",
      "END IF"
    ],
    "description": "An IF / ELSEIF / ELSE chain"
  },
  "If (single line)": {
    "prefix": "ifline",
    "body": ["IF ${1:condition} THEN ${0}"],
    "description": "A one-line IF with no END IF"
  },
  "For / Next": {
    "prefix": "for",
    "body": ["FOR ${1:i} = ${2:1} TO ${3:10}", "    ${0}", "NEXT ${1:i}"],
    "description": "A counted FOR loop"
  },
  "For / Next with Step": {
    "prefix": "forstep",
    "body": [
      "FOR ${1:i} = ${2:1} TO ${3:10} STEP ${4:2}",
      "    ${0}",
      "NEXT ${1:i}"
    ],
    "description": "A FOR loop with an explicit STEP"
  },
  "While / Wend": {
    "prefix": "while",
    "body": ["WHILE ${1:condition}", "    ${0}", "WEND"],
    "description": "A WHILE loop"
  },
  "Do / Loop Until": {
    "prefix": "do",
    "body": ["DO", "    ${1}", "LOOP UNTIL ${0:condition}"],
    "description": "A loop that always runs at least once"
  },
  "Do While / Loop": {
    "prefix": "dowhile",
    "body": ["DO WHILE ${1:condition}", "    ${0}", "LOOP"],
    "description": "A DO WHILE loop"
  },
  "Select Case": {
    "prefix": "select",
    "body": [
      "SELECT CASE ${1:value}",
      "    CASE ${2:1}",
      "        ${3}",
      "    CASE ELSE",
      "        ${0}",
      "END SELECT"
    ],
    "description": "A SELECT CASE block"
  },
  "Sub": {
    "prefix": "sub",
    "body": ["SUB ${1:Name}(${2:arg})", "    ${0}", "END SUB"],
    "description": "A subroutine"
  },
  "Function": {
    "prefix": "function",
    "body": [
      "FUNCTION ${1:Name}(${2:n})",
      "    ${1:Name} = ${0:n}",
      "END FUNCTION"
    ],
    "description": "A function — assign to its own name to return a value"
  },
  "Dim": {
    "prefix": "dim",
    "body": ["DIM ${1:name} AS ${0:INTEGER}"],
    "description": "Declare a variable with a type"
  },
  "Dim array": {
    "prefix": "dimarray",
    "body": ["DIM ${1:name}(${2:10}) AS ${0:INTEGER}"],
    "description": "Declare an array"
  },
  "Const": {
    "prefix": "const",
    "body": ["CONST ${1:NAME} = ${0:1}"],
    "description": "Declare a constant"
  },
  "Type": {
    "prefix": "type",
    "body": [
      "TYPE ${1:Name}",
      "    ${2:field} AS ${3:INTEGER}",
      "END TYPE"
    ],
    "description": "A user-defined record type"
  },
  "Print": {
    "prefix": "print",
    "body": ["PRINT ${0:\"text\"}"],
    "description": "Write a line to the terminal"
  },
  "Input": {
    "prefix": "input",
    "body": ["INPUT \"${1:What is your name}\"; ${0:name$}"],
    "description": "Prompt for a value and read it"
  },
  "Data / Read": {
    "prefix": "data",
    "body": ["DATA ${1:1, 2, 3}", "READ ${0:a}"],
    "description": "A DATA block and a READ that consumes it"
  },
  "Gosub": {
    "prefix": "gosub",
    "body": ["GOSUB ${1:Label}", "${0}", "${1:Label}:", "    RETURN"],
    "description": "Call a labelled subroutine and return"
  },
  "Randomize / Rnd": {
    "prefix": "random",
    "body": [
      "RANDOMIZE TIMER",
      "${1:n} = INT(RND * ${2:6}) + 1${0}"
    ],
    "description": "Seed the generator and take a random integer"
  },
  "Comment": {
    "prefix": "rem",
    "body": ["' ${0:note}"],
    "description": "A comment — an apostrophe starting a line"
  }
}
